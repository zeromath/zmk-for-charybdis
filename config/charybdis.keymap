#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC           &kp N1       &kp N2       &kp N3        &kp N4       &kp N5         &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp BACKSPACE
&kp TAB           &mt LS(Q) Q  &mt LS(W) W  &mt LS(E) E   &mt LS(R) R  &mt LS(T) T    &mt LS(Y) Y  &mt LS(U) U  &mt LS(I) I  &mt LS(O) O  &mt LS(P) P  &kp LEFT_BRACKET
&kp LEFT_CONTROL  &mt LS(A) A  &mt LS(S) S  &mt LS(D) D   &mt LS(F) F  &mt LS(G) G    &mt LS(H) H  &mt LS(J) J  &mt LS(K) K  &mt LS(L) L  &kp SEMI     &kp SQT
&kp LEFT_SHIFT    &mt LS(Z) Z  &mt LS(X) X  &mt LS(C) C   &mt LS(V) V  &mt LS(B) B    &mt LS(N) N  &mt LS(M) M  &kp COMMA    &kp DOT      &kp FSLH     &kp ENTER
                                            &kp LEFT_WIN  &mo 1        &kp ESCAPE     &kp SPACE    &mo 3
                                                          &mkp LCLK    &mkp RCLK      &mkp MCLK
            >;
        };

        F_layers {
            bindings = <
&none      &none            &none          &none      &none           &none           &none              &none   &none   &none   &none   &none
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN    &kp PLUS   &kp PIPE        &kp GRAVE       &kp DOUBLE_QUOTES  &kp N7  &kp N8  &kp N9  &none   &kp DELETE
&trans     &kp PERCENT      &kp DOLLAR     &kp CARET  &kp MINUS       &kp ASTERISK    &kp COLON          &kp N1  &kp N2  &kp N3  &kp N0  &kp BACKSPACE
&trans     &kp AMPERSAND    &kp BACKSLASH  &kp HASH   &kp UNDERSCORE  &kp QUESTION    &kp EQUAL          &kp N4  &kp N5  &kp N6  &none   &trans
                                           &trans     &trans          &To0_macro      &none              &none
                                                      &trans          &trans          &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans            &trans             &trans                &trans                 &trans    &trans          &trans          &trans         &trans           &trans  &trans
&trans  &trans            &trans             &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans    &kp HOME        &kp END         &kp PAGE_DOWN  &kp PAGE_UP      &trans  &trans
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &trans  &trans
&trans  &kp LESS_THAN     &kp GREATER_THAN   &trans                &trans                 &trans    &trans          &trans          &trans         &trans           &trans  &trans
                                             &trans                &trans                 &trans    &trans          &trans
                                                                   &trans                 &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };
    };
};
